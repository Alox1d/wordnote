    <!--android:id="@+id/action_html"-->
    <!--android:layout_width="40dp"-->
    <!--android:layout_height="40dp"-->
    <!--android:background="@android:color/transparent"-->
    <!--android:maxHeight="20dp"-->
    <!--android:maxWidth="20dp"-->
    <!--android:src="@drawable/terminal" />-->

    <ImageButton
        android:id="@+id/action_erase"
        android:layout_width="@dimen/editor_toolbar_buttion_size"
        android:layout_height="@dimen/editor_toolbar_buttion_size"
        android:background="?attr/selectableItemBackground"
        android:maxHeight="20dp"
        android:maxWidth="20dp"
        app:tint="?colorPrimary"

        android:src="@drawable/icon_erase" />
</LinearLayout>