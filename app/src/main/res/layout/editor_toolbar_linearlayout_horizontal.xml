<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:fadingEdge="horizontal"
    android:fadingEdgeLength="20dp"
    android:requiresFadingEdge="horizontal"
    android:layout_height="wrap_content"
    android:orientation="horizontal">
    <ImageButton
        android:id="@+id/action_recognize_voice"
        android:layout_width="@dimen/editor_toolbar_buttion_size"
        android:layout_height="@dimen/editor_toolbar_buttion_size"
        android:maxHeight="20dp"
        android:maxWidth="20dp"
        android:background="?attr/selectableItemBackground"
        app:tint="?colorPrimary"
        app:srcCompat="@drawable/ic_baseline_keyboard_voice_24" />
    <ImageButton
        android:id="@+id/action_recognize_image"
        android:layout_width="@dimen/editor_toolbar_buttion_size"
        android:layout_height="@dimen/editor_toolbar_buttion_size"
        android:maxHeight="20dp"
        android:maxWidth="20dp"
        android:background="?attr/selectableItemBackground"
        android:scaleType="centerInside"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:tint="?colorPrimary"
        app:srcCompat="@drawable/ic_text_recognition_icon" />
    <ImageButton
        android:id="@+id/action_insert_image"
        android:layout_width="@dimen/editor_toolbar_buttion_size"
        android:layout_height="@dimen/editor_toolbar_buttion_size"
        android:maxHeight="20dp"
        android:maxWidth="20dp"
        android:background="?attr/selectableItemBackground"


        app:tint="?colorPrimary"

        android:src="@drawable/icon_image" />


    <ImageButton
        android:id="@+id/action_bold"
        android:layout_width="@dimen/editor_toolbar_buttion_size"
        android:layout_height="@dimen/editor_toolbar_buttion_size"
        app:tint="?colorPrimary"
        android:background="?attr/selectableItemBackground"


        android:maxHeight="20dp"
        android:maxWidth="20dp"
        android:src="@drawable/icon_bold"

        />

    <ImageButton
        android:id="@+id/action_Italic"
        android:layout_width="@dimen/editor_toolbar_buttion_size"
        android:layout_height="@dimen/editor_toolbar_buttion_size"
        app:tint="?colorPrimary"
        android:background="?attr/selectableItemBackground"


        android:maxHeight="20dp"
        android:maxWidth="20dp"
        android:src="@drawable/icon_italic" />

    <ImageButton
        android:id="@+id/action_color"
        android:layout_width="@dimen/editor_toolbar_buttion_size"
        android:layout_height="@dimen/editor_toolbar_buttion_size"
        android:background="?attr/selectableItemBackground"



        android:maxHeight="20dp"
        android:padding="11dp"
        android:scaleType="centerInside"
        android:maxWidth="20dp"
        android:src="@drawable/ic_color_picker_circle" />

    <Button
        android:id="@+id/action_h1"
        android:layout_width="@dimen/editor_toolbar_buttion_size"
        android:layout_height="@dimen/editor_toolbar_buttion_size"
        android:width="@dimen/editor_toolbar_buttion_size"
        android:height="@dimen/editor_toolbar_buttion_size"
        style="?android:attr/borderlessButtonStyle"
        app:tint="?colorPrimary"

        android:text="H1"
        android:textColor="?colorPrimary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/action_h2"
        android:layout_width="@dimen/editor_toolbar_buttion_size"
        android:layout_height="@dimen/editor_toolbar_buttion_size"
        android:width="@dimen/editor_toolbar_buttion_size"
        android:height="@dimen/editor_toolbar_buttion_size"
        android:text="H2"
        app:tint="?colorPrimary"

        style="?android:attr/borderlessButtonStyle"

        android:textColor="?colorPrimary"
        android:textSize="16sp"
        android:textStyle="bold"

        />

    <Button
        android:id="@+id/action_h3"
        android:layout_width="@dimen/editor_toolbar_buttion_size"
        android:layout_height="@dimen/editor_toolbar_buttion_size"
        android:width="@dimen/editor_toolbar_buttion_size"
        android:height="@dimen/editor_toolbar_buttion_size"
        app:tint="?colorPrimary"

        style="?android:attr/borderlessButtonStyle"

        android:text="H3"
        android:textColor="?colorPrimary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/action_insert_link"
        android:layout_width="@dimen/editor_toolbar_buttion_size"
        android:layout_height="@dimen/editor_toolbar_buttion_size"
        app:tint="?colorPrimary"
        android:background="?attr/selectableItemBackground"


        android:maxHeight="20dp"
        android:maxWidth="20dp"
        android:src="@drawable/icon_link" />

    <ImageButton
        android:id="@+id/action_indent"
        android:layout_width="@dimen/editor_toolbar_buttion_size"
        android:layout_height="@dimen/editor_toolbar_buttion_size"
        app:tint="?colorPrimary"
        android:background="?attr/selectableItemBackground"


        android:maxHeight="20dp"
        android:maxWidth="20dp"
        android:src="@drawable/icon_indent" />


    <ImageButton
        android:id="@+id/action_outdent"
        android:layout_width="@dimen/editor_toolbar_buttion_size"
        android:layout_height="@dimen/editor_toolbar_buttion_size"
        app:tint="?colorPrimary"
        android:background="?attr/selectableItemBackground"


        android:maxHeight="20dp"
        android:maxWidth="20dp"
        android:src="@drawable/icon_outdent" />

    <ImageButton
        android:id="@+id/action_blockquote"
        android:layout_width="@dimen/editor_toolbar_buttion_size"
        android:layout_height="@dimen/editor_toolbar_buttion_size"
        app:tint="?colorPrimary"
        android:background="?attr/selectableItemBackground"


        android:maxHeight="20dp"
        android:maxWidth="20dp"
        app:srcCompat="@drawable/ic_blockquote" />


    <ImageButton
        android:id="@+id/action_bulleted"
        android:layout_width="@dimen/editor_toolbar_buttion_size"
        android:layout_height="@dimen/editor_toolbar_buttion_size"
        app:tint="?colorPrimary"
        android:background="?attr/selectableItemBackground"


        android:maxHeight="20dp"
        android:maxWidth="20dp"
        android:src="@drawable/icon_bullet_list" />

    <ImageButton
        android:id="@+id/action_unordered_numbered"
        android:layout_width="@dimen/editor_toolbar_buttion_size"
        android:layout_height="@dimen/editor_toolbar_buttion_size"
        app:tint="?colorPrimary"
        android:background="?attr/selectableItemBackground"


        android:maxHeight="20dp"
        android:maxWidth="20dp"
        android:src="@drawable/icon_numbered_list" />
<!--TODO: DISABLED BEUCASE OF TOAST IN THE CODE OF hr-->
    <ImageButton
        android:id="@+id/action_hr"
        android:layout_width="@dimen/editor_toolbar_buttion_size"
        android:layout_height="@dimen/editor_toolbar_buttion_size"
        app:tint="?colorPrimary"
        android:background="?attr/selectableItemBackground"


        android:maxHeight="20dp"
        android:maxWidth="20dp"
        android:src="@drawable/icon_hr"
        android:visibility="gone"
        />


    <!--<ImageButton-->
    <!--android:id="@+id/action_map"-->
    <!--android:layout_width="40dp"-->
    <!--android:layout_height="40dp"-->
    <!--android:background="@android:color/transparent"-->
    <!--android:maxHeight="20dp"-->
    <!--android:maxWidth="20dp"-->
    <!--android:src="@drawable/icon_marker" />-->


