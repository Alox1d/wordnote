<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000"
    android:fitsSystemWindows="true"
    android:keepScreenOn="true"
    android:orientation="vertical">


    <ru.alox1d.wordnote.huawei.device.service.tr.camera.LensEnginePreview
        android:id="@+id/live_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginBottom="0dp">

        <ru.alox1d.wordnote.huawei.ui.views.overlay.GraphicOverlay
            android:id="@+id/live_overlay"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_alignParentBottom="true" />
    </ru.alox1d.wordnote.huawei.device.service.tr.camera.LensEnginePreview>

    <ImageButton
        android:id="@+id/back"
        android:layout_width="@dimen/icon_back_width"
        android:layout_height="@dimen/icon_back_height"
        android:layout_marginStart="@dimen/icon_back_margin"
        android:layout_marginTop="@dimen/icon_back_margin"
        android:background="@drawable/button_circle_background"
        android:src="@drawable/black_back"
        app:tint="?colorPrimary" />

    <ImageButton
        android:id="@+id/text_imageSwitch"
        android:layout_width="@dimen/icon_back_width"
        android:layout_height="@dimen/icon_back_height"
        android:layout_marginTop="@dimen/icon_back_margin"
        android:layout_marginRight="20dp"
        android:layout_alignParentRight="true"
        android:background="@drawable/button_circle_background"
        android:padding="5dp"
        android:src="@mipmap/album_round"
        android:tint="?colorPrimary"
        />

    <RelativeLayout
        android:id="@+id/zoomImageLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:background="@color/black"
        android:visibility="gone">


        <ru.alox1d.wordnote.huawei.ui.views.overlay.ZoomImageView
            android:id="@+id/take_picture_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_alignParentBottom="true" />

        <ImageButton
            android:id="@+id/zoomImageClose"
            android:layout_width="@dimen/icon_back_width"
            android:layout_height="@dimen/icon_back_height"
            android:layout_alignParentLeft="true"
            android:layout_marginStart="@dimen/icon_back_margin"
            android:layout_marginTop="@dimen/icon_back_margin"
            android:background="@drawable/close"
            android:backgroundTint="?colorPrimary"

            />
        <include layout="@layout/fab_accept"/>

    </RelativeLayout>
    <ImageButton
        android:id="@+id/language_setting"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_below="@+id/text_imageSwitch"
        android:layout_marginTop="8dp"
        android:layout_marginRight="20dp"
        android:layout_alignParentRight="true"
        android:background="@drawable/button_circle_background"
        android:src="@mipmap/icon_language_setting"
        android:tint="?colorPrimary"
        />

    <ImageButton
        android:id="@+id/takePicture"
        android:layout_width="@dimen/circle_stroke_radius"
        android:layout_height="@dimen/circle_stroke_radius"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="5dp"
        android:background="@drawable/take_picture_stroke"
        android:backgroundTint="?colorPrimary" />
    <TextView
        android:id="@+id/tv_offline_text_recognition"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:text="@string/offline_text_recognition"
        android:layout_marginTop="@dimen/medium_margin"
        android:gravity="center"
        android:visibility="gone"
        android:enabled="false"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_17sp" />
    <FrameLayout
        android:id="@+id/fl_text"
        android:layout_width="@dimen/text_recognition_frame_width"
        android:layout_height="@dimen/text_recognition_frame_height"
        android:layout_centerInParent="true"
        android:background="@drawable/qr_code_reader_square"/>
</RelativeLayout>
